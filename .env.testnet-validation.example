
BLOCK_BUILDER_BRANCH=staging

# IGRA Network:
NETWORK=testnet

# HTTPS domain settings
IGRA_ORCHESTRA_DOMAIN=localhost
IGRA_ORCHESTRA_DOMAIN_EMAIL=igra@igralabs.com


# --- Docker Configuration ---

# Docker Image Source Configuration
# Set to true to use pre-built Docker Hub images for proprietary services
# Set to false to build from source code (requires access to private repositories)
# When true, setup-repos.sh will automatically pull and tag the images
USE_PREBUILT_IMAGES=false

# Logging driver for Docker containers.
# Defaults to 'syslog' which works well on Linux.
# On macOS, 'json-file' is recommended as 'syslog' might not be available or work correctly.
LOGGING_DRIVER=json-file
ENABLE_PERF_DIAGNOSTICS=false


# General and share configuration
RUST_LOG=debug
IGRA_CHAIN_ID=19416
MIN_PROTOCOL_FEE_PER_GAS_GWEI=2000

# Kaspad configuration
KASPAD_HOST=kaspad
KASPAD_BORSH_PORT=17210
KASPAD_ADD_PEER=195.201.57.142


# Viaduct configuration
REPLAY_ON_ERROR=-1
SYNC_THREADS=64
MAGIC_SPK=20aeb014c0814f5c549bbea36638e08b1e8d4c1b8251780841fce1fdcbf72ee01dac
DELAY_WINDOWS=3


EL_ONE_TIME_ADDRESS=0x2B7dABDF193677725C6Ecd25dc7CfAf6054193d8

# RPC Access Tokens (ensure that they are 32 hexadecimal characters)
RPC_ACCESS_TOKEN_1=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Worker 0 configuration
W0_WALLET_TO_ADDRESS=kaspatest:qrpszpd7m630x0axxghfhyst0e8c26enw804fgx4umccgmeuvd9px6gznfj2c
W0_KASWALLET_PASSWORD=

# --- S3 Backup Configuration (Optional) ---
# Configure these settings to enable automatic backup uploads to AWS S3
# AWS credentials should be configured via AWS CLI or IAM roles, not in this file

# S3 bucket name for storing backups
S3_BACKUP_BUCKET=igralabs-viaduct-archival-data

# AWS region where the S3 bucket is located
S3_BACKUP_REGION=eu-north-1

# Number of backups to retain in S3 (older backups will be automatically deleted)
S3_BACKUP_RETENTION_COUNT=10

# Enable dry-run mode for testing (no actual S3 operations will be performed)
S3_BACKUP_DRY_RUN=false

# Automatically upload backups to S3 after local backup completes
S3_BACKUP_AUTO_UPLOAD=false

# S3 storage class for cost optimization (STANDARD, STANDARD_IA, GLACIER, etc.)
S3_BACKUP_STORAGE_CLASS=STANDARD_IA

# --- Cron Backup Configuration (Optional) ---
# Containers to backup via cron (space-separated list)
CRON_BACKUP_CONTAINERS="viaduct"

# AWS profile to use for cron S3 uploads (if different from default)
AWS_PROFILE=igra-labs