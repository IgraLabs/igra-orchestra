# IGRA read-only RPC stack — mainnet configuration
#
# For docker-compose.readonly-rpc.yml: a minimal read-only Igra node
# co-located on a hardened host, serving eth_* reads to a local consumer
# as RPC_URL_1 = http://igra-local-rpc:8545.
#
# Read doc/node-operations/readonly-rpc-node.md before using this file.
# Render with:
#   cp .env.readonly-rpc.example .env
#   docker compose -f docker-compose.readonly-rpc.yml config -q
#
# This stack CANNOT broadcast transactions — no kaswallet, and the proxy is
# read-only. Anything that submits a transaction goes through an external
# funded endpoint.

# --- Docker Configuration ---
# The compose file hardcodes the journald log driver: the host operator is
# unprivileged and cannot read /var/lib/docker, and a json-file fallback would
# silently reintroduce unbounded log growth on a signer host. There is
# deliberately no LOGGING_DRIVER knob here.
SERVICE_RESTART_POLICY=unless-stopped

# --- Image Versions ---
# Deliberately separate from versions.mainnet.env. Two capabilities this stack
# depends on are not in the mainnet pins, and both fail SILENTLY rather than
# loudly if an older image is used:
#   - reth must support IGRA_RETH_PRUNE_DISTANCE_BLOCKS. An older launcher
#     ignores the variable and runs archive mode.
#   - rpc-provider must start without a wallet. The mainnet image builds its
#     wallet client and requires KASWALLET_PASSWORD before it binds a
#     listener, so it exits before serving a single request here.
# Fill these in only with tags verified to carry those capabilities, then
# confirm at bring-up (see the runbook's release-gate checks).
# Digest-pin all three. A bare tag is mutable — the same string can resolve to
# different bytes tomorrow, on a host deliberately co-located with something
# sensitive — and the host-side verifier will not catch it: it inspects the
# image ID rather than RepoDigests, so a bare tag passes its digest check.
# Resolve with: docker buildx imagetools inspect igranetwork/kaspad:3.0
READONLY_RPC_KASPAD_VERSION=TODO_KASPAD_TAG_AT_DIGEST_REPLACE_ME
READONLY_RPC_RETH_VERSION=TODO_RETH_PRUNING_TAG_REPLACE_ME
READONLY_RPC_PROXY_VERSION=TODO_PROXY_WALLETLESS_TAG_REPLACE_ME

# --- Storage Layout ---
# Provisioned by the host runbook. Both subdirectories (kaspad/, reth/) must
# exist and be writable by the container UID before first start; the compose
# file uses create_host_path: false so a typo fails at container create
# instead of silently syncing from genesis onto the wrong filesystem.
IGRA_DATA_ROOT=/srv/igra

# Shared engine-API JWT, mounted read-only into both kaspad and reth.
IGRA_JWT_PATH=/srv/igra/keys/jwt.hex

# --- IGRA Network Configuration ---
NETWORK=mainnet

# Two-stage initial sync. Stage 1 runs with IGRA_ENABLE=false so kaspad syncs
# L1 without IGRA/ATAN overhead; stage 2 sets it to true and restarts. This
# file ships stage 1 as the default state — do not skip it.
IGRA_ENABLE=false

# --- IGRA Mainnet Chain Configuration ---
IGRA_CHAIN_ID=38833
IGRA_LAUNCH_DAA_SCORE=366020000
GENESIS_BLOCK_HASH=0x5e8f8cf83aff01f82ccb35509186b1fef48043caab1d587c4209457a3c01866b
TX_ID_PREFIX=97b1
# Post-KIP21 dedicated IGRA lane namespace (4 bytes / 8 lowercase hex chars,
# no 0x prefix). Reaches kaspad as --igra-lane-id and the proxy as
# IGRA_LANE_ID. ATAN CDN paths use the network-specific TX_ID_PREFIX, not this
# lane (97b10000 is shared by every network).
IGRA_LANE_ID=97b10000
L1_REFERENCE_TIMESTAMP=1771977542
L1_REFERENCE_DAA_SCORE=365578320
MIN_PROTOCOL_FEE_PER_GAS_GWEI=1000
IGRA_ENTRY_MIN_AMOUNT=1000000000

# Lock script public key (entry transaction verification is enforced)
IGRA_LOCK_SCRIPT_PUBKEY=aa205933185b78c71f0833770ca4aa6b62423af00d0efc2832025a23999543f220f787

# Execution Layer one-time address
EL_ONE_TIME_ADDRESS=0x98343326Bd4B60203b82F1fc0Ff8Df054E119e81

# Reference block hashes for network identity (used in extradata computation)
BITCOIN_BLOCK_HASH=00000000000000000000e01836a937f766ff05c1b58225735fbcafc878c1affa
ETHEREUM_BLOCK_HASH=0xb8962b302fdff29f505a9e42b022141209c1ee1c71d5047a94a75ad2a03c17dc
KASPA_BLOCK_HASH=c260382c6ab3d63180633b6d4da8511db4d355a1144eaa82bb44216c3cfbfc32

# Optional: post-fork lock script migration (both must be set together or both empty)
# POST_FORK_LOCK_SCRIPT_PUBKEY=
# LOCK_SCRIPT_FORK_DAA_SCORE=

# --- Bounded Storage ---
# Reth history distance, in blocks behind the tip, for four segments only:
# sender recovery, receipts, account history, storage history. Block bodies,
# transaction lookup and current state are retained indefinitely, so this
# bounds those four segments — it does NOT bound total disk. The host capacity
# guard remains required.
#
# 600000 blocks is about 7.3 days at the sampled cadence (574,800 blocks over
# 604,776 s on 2026-08-18, i.e. ~1.05 s/block; one week is ~574,850 blocks, so
# this carries roughly 4% margin). Remeasure before relying on it: take the
# current head, subtract the head from a week ago, and use that difference.
#
# ONE-WAY. Reth persists pruning into the data directory's reth.toml. Removing
# this variable does not restore archive behaviour, and raising the distance
# does not bring deleted history back. Rollback is destroying
# ${IGRA_DATA_ROOT}/reth and resyncing. Set it correctly before the first sync.
#
# Consequence for the consumer: eth_getLogs and receipts older than the window
# are unavailable here, so RPC_URL_2 must be archive-capable.
IGRA_RETH_PRUNE_DISTANCE_BLOCKS=600000

# Locally retained L1 block history, in days. The other half of the footprint:
# a one-week L2 window beside an unbounded L1 store would not meet the
# requirement. Note this is HEAVIER than kaspad's ~30-hour default — it is the
# one-week requirement applied to L1, not the lightest possible setting. The
# floor kaspad accepts is 2 days, and its own size estimate excludes non-block
# stores, so this is not a hard disk bound either.
KASPAD_RETENTION_PERIOD_DAYS=7

# --- Logging ---
# kaspad's mainnet service definition hardcodes trace on six targets; this
# stack resets it. Raise deliberately and temporarily for diagnosis only.
RUST_LOG=info
# The proxy logs every request at info and consumers poll continuously.
RPC_PROXY_RUST_LOG=warn
ENABLE_PERF_DIAGNOSTICS=false
ENABLE_EVENT_LOGGING=false

# --- ATAN Import Configuration ---
# ATAN auto-import URL is auto-constructed as
# {CDN_BASE_URL}/{NETWORK}/{TX_ID_PREFIX}/index.pb (= /mainnet/97b1/index.pb).
# Set ATAN_IMPORT_URL to override.
CDN_BASE_URL=https://dyehoijgeqfp8.cloudfront.net

# --- Kaspad Configuration ---
# No ports are published. KASPAD_GRPC_PORT is still needed because the
# healthcheck probes it inside the container.
KASPAD_GRPC_PORT=16110

# Optional: pin an extra peer in addition to the DNS seeds.
# KASPAD_ADD_PEER=

# Optional: reject peers by user-agent, e.g. reject;ver:kaspad<1.2.1
# KASPAD_UA_RULE=

# Optional: skip entry lock-script verification. Leave unset in production.
# IGRA_SKIP_LOCK_SCRIPT_CHECK=

# Optional: start IGRA processing from a specific L2 block instead of genesis.
# WARM_START_BLOCK=
