# ATAN-Only Mode Configuration
# Runs kaspad saving finality periods without the full IGRA stack
# Usage: docker compose -f docker-compose.atan.yml up -d
# With uploader: docker compose -f docker-compose.atan.yml --profile atan-uploader up -d

# --- Docker Configuration ---
LOGGING_DRIVER=json-file
SERVICE_RESTART_POLICY=unless-stopped

# --- Network ---
NETWORK=mainnet

# --- Kaspad Ports ---
KASPAD_GRPC_PORT=16110
KASPAD_P2P_PORT=16111
KASPAD_BORSH_PORT=17110
KASPAD_JSON_PORT=18110

# --- ATAN Configuration ---
# TX_ID_PREFIX is the legacy pre-KIP21 transaction ID prefix; kaspad still
# uses it for ATAN filtering and as the fallback ATAN import namespace when
# IGRA_LANE_ID is unset.
TX_ID_PREFIX=97b1
# Post-KIP21 dedicated IGRA lane namespace (4 bytes / 8 lowercase hex chars,
# no 0x prefix). kaspad receives --igra-lane-id=$IGRA_LANE_ID and the
# auto-constructed ATAN import URL uses this value instead of TX_ID_PREFIX.
IGRA_LANE_ID=97b10000
CDN_BASE_URL=https://dyehoijgeqfp8.cloudfront.net
# Override auto-constructed import URL:
# - {CDN_BASE_URL}/{NETWORK}/{IGRA_LANE_ID}/index.pb when IGRA_LANE_ID is set
# - {CDN_BASE_URL}/{NETWORK}/{TX_ID_PREFIX}/index.pb otherwise
# ATAN_IMPORT_URL=
# Galleon testnet-10 needs the prefix-based pin until the lane-based
# /testnet-10/97b10000/index.pb object is published; the prefix-based
# /testnet-10/97b4/index.pb serves the same data today:
# ATAN_IMPORT_URL=https://dyehoijgeqfp8.cloudfront.net/testnet-10/97b4/index.pb
# Optional: connect to a specific peer
# KASPAD_ADD_PEER=

# --- Image Versions ---
KASPAD_VERSION=2.3
ATAN_UPLOADER_VERSION=2.1

# --- ATAN Uploader (optional, use with --profile atan-uploader) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=atan-import
# DATADIR=/app/data/kaspa-mainnet/datadir
# DATADIR=/app/data/kaspa-testnet-10/datadir
# UPLOAD_JITTER_MAX_SECONDS=60
