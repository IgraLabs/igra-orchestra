# Docker image versions for MAINNET deployments
#
# kaspad and reth use the v<upstream>-igra.<n> release scheme (ENG-1243): the
# version tracks the upstream rusty-kaspa/reth base, and .<n> is the IGRA
# revision on that base. The number is lower than the retired 3.0 line but the
# code is newer -- 2.0.1-igra.1 is two commits ahead of rusty-kaspa-private git
# tag v3.0.2, and the 2.5.1-igra.<n> line re-ports IGRA behaviour onto upstream
# reth git tag v2.5.1. Do not "fix" these back to 3.0, and do not shorten them: bare
# 2.0.1 is a January build, a real seven-month downgrade. These are semver
# pre-release versions, so docker/metadata-action publishes no floating alias
# for them -- pin the full string. kaspad currently also dual-publishes this
# same commit as 3.1.0 during the scheme migration; prefer the igra tag.
KASPAD_VERSION=2.0.1-igra.1
RETH_VERSION=2.5.1-igra.2
# kaswallet must stay on 3.x: the compose entrypoint passes --subnetwork-id
# unconditionally, which older majors reject, and 3.0.3+ is required for the
# atomic keys.json save the per-worker directory mounts depend on.
KASWALLET_VERSION=3.0
RPC_PROVIDER_VERSION=3.0
NODE_HEALTH_CHECK_VERSION=2.4
ATAN_UPLOADER_VERSION=2.1
