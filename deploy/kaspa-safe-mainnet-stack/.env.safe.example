# Mainnet Safe Transaction Service deployment.
# Copy to .env.safe with ./scripts/prepare.sh and replace every CHANGE_ME.
#
# No federation/custody/signing secrets belong in this file.
# DJANGO_SECRET_KEY and POSTGRES_PASSWORD are ordinary web-app/DB credentials.
# Operators must provide them explicitly; this mainnet bundle does not generate
# credentials automatically.

COMPOSE_PROJECT_NAME=igra-safe-mainnet

# Source repos used by Docker builds.
SAFE_TRANSACTION_SERVICE_REPO_URL=git@github.com:IgraLabs/safe-transaction-service.git
SAFE_TRANSACTION_SERVICE_BRANCH=kaspa-native-wallet-integration
IGRA_PROPOSAL_BUILDER_RS_REPO_URL=git@github.com:IgraLabs/igra-proposal-builder-rs.git
IGRA_PROPOSAL_BUILDER_RS_BRANCH=feature/rust-proposal-builder

# Built image.
SAFE_API_IMAGE=igra-kaspa-safe-api-mainnet:local

# Safe API is meant to sit behind a real HTTPS reverse proxy/LB.
# Keep loopback bind unless the host-level network design requires otherwise.
SAFE_API_BIND=127.0.0.1
SAFE_API_PORT=8888
SAFE_PUBLIC_URL=https://safe-transaction-service.igralabs.com

# Django/Safe API runtime.
DJANGO_SECRET_KEY=CHANGE_ME_OPERATOR_SUPPLIED_DJANGO_SECRET_KEY
DJANGO_ALLOWED_HOSTS=safe-transaction-service.igralabs.com,localhost,127.0.0.1
DJANGO_ADMIN_URL=admin/
WEB_CONCURRENCY=2
GUNICORN_REQUEST_TIMEOUT=60
KASPA_PST_HELPER_PATH=/usr/local/bin/kaspa-pst
KASPA_PST_HELPER_TIMEOUT=30

# Upstream Safe migrations query chain id. Use real Igra L2 mainnet JSON-RPC.
ETHEREUM_NODE_URL=https://CHANGE_ME_REAL_IGRA_L2_MAINNET_RPC
ETHEREUM_TRACING_NODE_URL=
ETH_L2_NETWORK=true

# Local Postgres. If DevOps moves to managed Postgres later, keep the same
# DATABASE_URL contract and adapt compose separately.
POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_DB=safe_transaction_service
POSTGRES_USER=safe
POSTGRES_PASSWORD=CHANGE_ME_OPERATOR_SUPPLIED_POSTGRES_PASSWORD
DATABASE_URL=psql://safe:CHANGE_ME_OPERATOR_SUPPLIED_POSTGRES_PASSWORD@postgres:5432/safe_transaction_service

# Local Redis.
REDIS_IMAGE=redis:7-alpine
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=django://
