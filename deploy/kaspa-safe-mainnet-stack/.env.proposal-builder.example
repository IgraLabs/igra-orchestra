# Mainnet proposal-builder daemon deployment.
# Copy to .env.proposal-builder with ./scripts/prepare.sh and review.
#
# This file has no private wallet keys. Proposal-builder must never hold signer
# private keys or seed phrases.

COMPOSE_PROJECT_NAME=igra-proposal-builder-mainnet

# Source repo used by Docker build.
IGRA_PROPOSAL_BUILDER_RS_REPO_URL=git@github.com:IgraLabs/igra-proposal-builder-rs.git
IGRA_PROPOSAL_BUILDER_RS_BRANCH=feature/rust-proposal-builder

PROPOSAL_BUILDER_IMAGE=igra-proposal-builder-rs-mainnet:local
IGRA_PROPOSAL_BUILDER_CONFIG=/config/proposal-builder.json
KASPA_EXIT_BUILDER_MODE=daemon
KASPA_EXIT_BUILDER_POLL_SECONDS=300
RUST_LOG=info
