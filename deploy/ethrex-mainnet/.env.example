# IGRA mainnet deployment with ethrex as the execution layer.
# Copy this file to the orchestra repo root as .env and append versions.mainnet.env.
# Fill all placeholders before first launch.

# --- Docker Configuration ---
COMPOSE_PROJECT_NAME=mainnet_ethrex
# Use Docker Hub images for orchestra services; ethrex is built separately by
# docker-compose.ethrex-mainnet.yml from build/repos/ethrex.
USE_PREBUILT_IMAGES=true
LOGGING_DRIVER=json-file
SERVICE_RESTART_POLICY=unless-stopped

# --- IGRA Network Configuration ---
NETWORK=mainnet
IGRA_ENABLE=true

# --- IGRA Mainnet Chain Configuration ---
IGRA_CHAIN_ID=38833
IGRA_LAUNCH_DAA_SCORE=366020000
GENESIS_BLOCK_HASH=0x5e8f8cf83aff01f82ccb35509186b1fef48043caab1d587c4209457a3c01866b
TX_ID_PREFIX=97b1
L1_REFERENCE_TIMESTAMP=1771977542
L1_REFERENCE_DAA_SCORE=365578320
MIN_PROTOCOL_FEE_PER_GAS_GWEI=1000
IGRA_ENTRY_MIN_AMOUNT=1000000000

# Lock script address:
# kaspa:qr8gc0c35du8wucq0v4nxnup2t86gmemhceqepakh8j4tfhyqpvf0s453d5d9
IGRA_LOCK_SCRIPT_PUBKEY=aa205933185b78c71f0833770ca4aa6b62423af00d0efc2832025a23999543f220f787

# Execution Layer one-time address.
EL_ONE_TIME_ADDRESS=0x98343326Bd4B60203b82F1fc0Ff8Df054E119e81

# Reference block hashes for network identity and EL genesis extraData.
# Required by ethrex /app/run-igra-el.sh.
BITCOIN_BLOCK_HASH=00000000000000000000e01836a937f766ff05c1b58225735fbcafc878c1affa
ETHEREUM_BLOCK_HASH=0xb8962b302fdff29f505a9e42b022141209c1ee1c71d5047a94a75ad2a03c17dc
KASPA_BLOCK_HASH=c260382c6ab3d63180633b6d4da8511db4d355a1144eaa82bb44216c3cfbfc32

# Optional post-fork lock script migration; set both or leave both empty.
POST_FORK_LOCK_SCRIPT_PUBKEY=
LOCK_SCRIPT_FORK_DAA_SCORE=

# --- Execution Layer Image ---
# build/repos/ethrex must exist when building locally.
ETHREX_VERSION=mainnet-local

# --- Logging Configuration ---
RUST_LOG=info
ENABLE_PERF_DIAGNOSTICS=false
ENABLE_EVENT_LOGGING=false

# --- ATAN Import Configuration ---
CDN_BASE_URL=https://dyehoijgeqfp8.cloudfront.net
ATAN_IMPORT_URL=

# --- Kaspad Configuration ---
KASPAD_HOST=kaspad
KASPAD_GRPC_PORT=16110
KASPAD_P2P_PORT=16111
KASPAD_BORSH_PORT=17110
KASPAD_JSON_PORT=18110
KASPAD_ADD_PEER=

# --- RPC Configuration ---
RPC_READ_ONLY=false

# --- Node Settings ---
NODE_ID=MN-ethrex-integration
HEALTH_CHECK_API_KEY=7f2e9b4d8c1a6e3f5b9d2c7a4e8f1b6d3c9a5e7f2b8d4c6a1e9f3b7d5c2a8e4f
NODE_HEALTH_CHECK_URL=status.igralabs.com

# --- HTTPS Domain Settings ---
IGRA_ORCHESTRA_DOMAIN=mainnet-ethrex.local
IGRA_ORCHESTRA_DOMAIN_EMAIL=devnull@igralabs.com

# --- Core Contracts Configuration ---
CLONE_CORE_CONTRACTS=false
CORE_CONTRACTS_BRANCH=main

# --- Worker Configuration ---
# Replace with generated mainnet wallet addresses/passwords before enabling frontend profiles.
W0_WALLET_TO_ADDRESS=kaspa:qpjdhxr6642qjs4hg874cw555ez78yt3tn39uu0flmt0z8ur2gczcwftnuszs
W0_KASWALLET_PASSWORD=<your-password>
