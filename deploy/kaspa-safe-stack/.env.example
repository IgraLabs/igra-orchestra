# Copy to .env. scripts/prepare.sh does this automatically and fills secrets.

COMPOSE_PROJECT_NAME=igra-kaspa-safe-testnet

# Source repos used by the Docker build context.
SAFE_TRANSACTION_SERVICE_REPO_URL=git@github.com:IgraLabs/safe-transaction-service.git
SAFE_TRANSACTION_SERVICE_BRANCH=kaspa-native-wallet-integration
IGRA_PROPOSAL_BUILDER_RS_REPO_URL=git@github.com:IgraLabs/igra-proposal-builder-rs.git
IGRA_PROPOSAL_BUILDER_RS_BRANCH=feature/rust-proposal-builder

# Images built locally by this bundle.
SAFE_API_IMAGE=igra-kaspa-safe-api:local
PROPOSAL_BUILDER_IMAGE=igra-proposal-builder-rs:local

# Public port exposed on this host. Put TLS/WAF/reverse-proxy in front of it.
SAFE_API_PORT=8888

# Django/Safe API runtime.
DJANGO_SECRET_KEY=CHANGE_ME_GENERATED_BY_PREPARE
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,safe-transaction-service.igralabs.com
DJANGO_ADMIN_URL=admin/
WEB_CONCURRENCY=2
GUNICORN_REQUEST_TIMEOUT=60
KASPA_PST_HELPER_PATH=/usr/local/bin/kaspa-pst
KASPA_PST_HELPER_TIMEOUT=30

# Postgres.
POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_DB=safe_transaction_service
POSTGRES_USER=safe
POSTGRES_PASSWORD=CHANGE_ME_GENERATED_BY_PREPARE
DATABASE_URL=psql://safe:CHANGE_ME_GENERATED_BY_PREPARE@postgres:5432/safe_transaction_service

# Redis.
REDIS_IMAGE=redis:7-alpine
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=django://

# Optional proposal-builder daemon. Safe API works without this service.
IGRA_PROPOSAL_BUILDER_CONFIG=/config/proposal-builder.json
KASPA_EXIT_BUILDER_MODE=daemon
KASPA_EXIT_BUILDER_POLL_SECONDS=300
RUST_LOG=info
