FROM rust:1.91-bookworm AS builder

WORKDIR /src
RUN apt-get update \
    && apt-get install -y --no-install-recommends clang cmake git libclang-dev libssl-dev pkg-config protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

COPY build/repos/igra-proposal-builder-rs/ .
RUN mkdir -p /out \
    && cargo build --locked --release -p igra-proposal-builder -p kaspa-pst \
    && cp target/release/igra-proposal-builder /out/igra-proposal-builder \
    && cp target/release/kaspa-pst /out/kaspa-pst

FROM debian:trixie-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends bash ca-certificates tini \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /out/igra-proposal-builder /usr/local/bin/igra-proposal-builder
COPY --from=builder /out/kaspa-pst /usr/local/bin/kaspa-pst
COPY scripts/dev/kaspa-exit-proposal-builder-entrypoint.sh /app/kaspa-exit-proposal-builder-entrypoint.sh

RUN chmod +x /usr/local/bin/igra-proposal-builder /usr/local/bin/kaspa-pst /app/kaspa-exit-proposal-builder-entrypoint.sh

ENTRYPOINT ["/usr/bin/tini", "--", "/app/kaspa-exit-proposal-builder-entrypoint.sh"]
