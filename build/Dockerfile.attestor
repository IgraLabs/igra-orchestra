FROM rust:slim AS builder

WORKDIR /app

# Install build dependencies including OpenSSL, pkg-config, and protobuf compiler
RUN apt-get update && \
    apt-get install -y pkg-config libssl-dev protobuf-compiler && \
    rm -rf /var/lib/apt/lists/*

COPY . .

RUN cargo build --release

# Runtime stage
FROM rust:slim

WORKDIR /app

# Install runtime dependencies including curl for healthchecks
RUN apt-get update && \
    apt-get install -y libssl-dev ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*

# Copy the attestor binary from builder stage
COPY --from=builder /app/target/release/igra-attestation /app/

ENTRYPOINT ["/app/igra-attestation"]
