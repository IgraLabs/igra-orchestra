# Frigate Public Testnet (testnet-12) Services Configuration
#
# ============================================================================
# WARNING: This file ships with TODO_TN12_*_REPLACE_ME placeholders.
# You MUST replace every TODO_TN12_*_REPLACE_ME value before launching the
# stack. Kaspad/Reth/RPC provider will fail loudly on any unreplaced value.
# Tracked values to fill in: see .context/plans/tn12-docker-tags.md
# ============================================================================

# --- Docker Configuration ---
# Use pre-built Docker Hub images unless you are building from private source repos.
USE_PREBUILT_IMAGES=true

# Logging driver for Docker containers
# Linux: 'syslog'; macOS: 'json-file'
LOGGING_DRIVER=json-file
SERVICE_RESTART_POLICY=no

# --- IGRA Network Configuration ---
NETWORK=testnet-12

# Set false for initial kaspad sync without IGRA overhead, then restart with true.
IGRA_ENABLE=true

# --- Frigate Testnet Chain Configuration ---
IGRA_CHAIN_ID=TODO_TN12_IGRA_CHAIN_ID_REPLACE_ME
IGRA_LAUNCH_DAA_SCORE=TODO_TN12_IGRA_LAUNCH_DAA_SCORE_REPLACE_ME
GENESIS_BLOCK_HASH=TODO_TN12_GENESIS_BLOCK_HASH_REPLACE_ME
TX_ID_PREFIX=TODO_TN12_TX_ID_PREFIX_REPLACE_ME
# Post-KIP21 dedicated IGRA lane namespace (4 bytes / 8 lowercase hex chars,
# no 0x prefix). Reaches kaspad as --igra-lane-id, kaswallet as
# --subnetwork-id (appended by the docker-compose.yml entrypoint), and RPC
# as IGRA_LANE_ID; ATAN CDN paths use this value instead of TX_ID_PREFIX.
IGRA_LANE_ID=97b10000
L1_REFERENCE_TIMESTAMP=TODO_TN12_L1_REFERENCE_TIMESTAMP_REPLACE_ME
L1_REFERENCE_DAA_SCORE=TODO_TN12_L1_REFERENCE_DAA_SCORE_REPLACE_ME
MIN_PROTOCOL_FEE_PER_GAS_GWEI=TODO_TN12_MIN_PROTOCOL_FEE_PER_GAS_GWEI_REPLACE_ME
IGRA_ENTRY_MIN_AMOUNT=TODO_TN12_IGRA_ENTRY_MIN_AMOUNT_REPLACE_ME

# Lock script public key for entry transaction verification
IGRA_LOCK_SCRIPT_PUBKEY=TODO_TN12_IGRA_LOCK_SCRIPT_PUBKEY_REPLACE_ME

# Execution Layer one-time address
EL_ONE_TIME_ADDRESS=TODO_TN12_EL_ONE_TIME_ADDRESS_REPLACE_ME

# Required network identity hashes. Replace TODO sentinels before first launch.
BITCOIN_BLOCK_HASH=TODO_TN12_BITCOIN_BLOCK_HASH_REPLACE_ME
ETHEREUM_BLOCK_HASH=TODO_TN12_ETHEREUM_BLOCK_HASH_REPLACE_ME
KASPA_BLOCK_HASH=TODO_TN12_KASPA_BLOCK_HASH_REPLACE_ME

# Optional: post-fork lock script migration (both must be set together or both empty)
# POST_FORK_LOCK_SCRIPT_PUBKEY=
# LOCK_SCRIPT_FORK_DAA_SCORE=

# --- Logging Configuration ---
RUST_LOG=info
ENABLE_PERF_DIAGNOSTICS=false
ENABLE_EVENT_LOGGING=false

# --- ATAN Import Configuration ---
# Kaspad builds the ATAN import URL as {CDN_BASE_URL}/{NETWORK}/{IGRA_LANE_ID}/index.pb
# when IGRA_LANE_ID is set. Confirm the /testnet-12/ lane CDN path exists before first launch.
CDN_BASE_URL=https://dyehoijgeqfp8.cloudfront.net

# --- Kaspad Configuration ---
KASPAD_HOST=kaspad
KASPAD_GRPC_PORT=16210
KASPAD_P2P_PORT=16211
KASPAD_BORSH_PORT=17210
KASPAD_JSON_PORT=18210

# Optional bootstrap peer. Set during Frigate launch if DNS seeds are not populated yet.
KASPAD_ADD_PEER=

# --- RPC Configuration ---
# Set to true for read-only RPC (no transaction submission)
# Set to false if you want to accept and submit user transactions (requires funded wallets)
RPC_READ_ONLY=false

# --- Node Settings ---
NODE_ID=FTN-<your-unique-node-name>

# Shared testnet monitoring API key (public for Frigate testnet)
HEALTH_CHECK_API_KEY=TODO_TN12_HEALTH_CHECK_API_KEY_REPLACE_ME

# Node health check monitoring server (required for health reporting)
NODE_HEALTH_CHECK_URL=TODO_TN12_NODE_HEALTH_CHECK_URL_REPLACE_ME

# --- HTTPS Domain Settings ---
IGRA_ORCHESTRA_DOMAIN=<your-domain.com>
IGRA_ORCHESTRA_DOMAIN_EMAIL=<you@your-domain.com>

# --- Upstream RPC Load Balancer ---
# Upstream RPC load balancer hostname, once ops publishes it. Leave empty for direct-internet deployments.
RPC_LB_HOSTNAME=
ORCHESTRA_TRUSTED_PROXIES=

# --- Core Contracts Configuration (Optional) ---
# Set to true only if you need to deploy or modify IGRA core contracts
# This repository is not available as a pre-built image and will be cloned from source
CLONE_CORE_CONTRACTS=false
CORE_CONTRACTS_BRANCH=main

# --- ATAN Uploader Configuration (optional, use with --profile atan-uploader) ---
# Data directory matches kaspad's internal testnet-12 layout.
DATADIR=/app/data/kaspa-testnet-12/datadir

# --- Worker Configuration ---
# All wallet addresses must use testnet prefix: kaspatest:
# Generate keys for Frigate (see versions.frigate-testnet.env for the image tag):
#   docker run --rm -it -v $(pwd)/keys:/keys --entrypoint /app/kaswallet-create \
#     igranetwork/kaswallet:$(grep KASWALLET_VERSION versions.frigate-testnet.env | cut -d= -f2) --testnet -k /keys/keys.kaswallet-X.json

# WARNING: WALLET_TO_ADDRESS receives transaction change. Before setting
# RPC_READ_ONLY=false, replace placeholders with your wallet addresses or funds
# can be lost. See the RPC transaction submission docs.

# Worker 0
W0_WALLET_TO_ADDRESS=kaspatest:qpvud9rdcqnqydqqfz2xunkh69xv5pflfacpjvrdgvdfven8yu2fcknegxade
W0_KASWALLET_PASSWORD=<your-password>

# Worker 1
W1_WALLET_TO_ADDRESS=kaspatest:qpvud9rdcqnqydqqfz2xunkh69xv5pflfacpjvrdgvdfven8yu2fcknegxade
W1_KASWALLET_PASSWORD=<your-password>

# Worker 2
W2_WALLET_TO_ADDRESS=kaspatest:qpvud9rdcqnqydqqfz2xunkh69xv5pflfacpjvrdgvdfven8yu2fcknegxade
W2_KASWALLET_PASSWORD=<your-password>

# Worker 3
W3_WALLET_TO_ADDRESS=kaspatest:qpvud9rdcqnqydqqfz2xunkh69xv5pflfacpjvrdgvdfven8yu2fcknegxade
W3_KASWALLET_PASSWORD=<your-password>

# Worker 4
W4_WALLET_TO_ADDRESS=kaspatest:qpvud9rdcqnqydqqfz2xunkh69xv5pflfacpjvrdgvdfven8yu2fcknegxade
W4_KASWALLET_PASSWORD=<your-password>
